# Only compose.local.yaml uses these host bindings. Coolify uses compose.yaml
# without host ports; attach a HTTPS domain to web's internal port 8080.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
API_PORT=3001

# Empty = same origin for OpenAPI and documentation links (recommended).
# Optionally set both to your separate HTTPS API origin, without trailing slash.
API_PUBLIC_URL=
VITE_PUBLIC_API_URL=

# Exact browser origin(s), comma separated; no trailing slashes or wildcards.
CORS_ORIGIN=http://localhost:8080

# Shared upstream cache and request timeout; values remain bounded by the API.
CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=8000

# Compose stores SQLite in /data/hnd.sqlite on the hnd-data named volume.
# Direct npm start: DB_PATH defaults to ./data/hnd.sqlite in the API working dir.
OBSERVATION_RETENTION_DAYS=90
REFRESH_INTERVAL_SECONDS=300

# Compose API is private, behind Nginx/Coolify. Direct public API: set false.
TRUST_PROXY=true

# No API key or account is needed for the integrated public sources.

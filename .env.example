# Docker Compose: local access. With Coolify, attach a domain to each service.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
API_PORT=3001

# Public API origin, no trailing slash. Replace both for production.
API_PUBLIC_URL=http://localhost:3001
VITE_PUBLIC_API_URL=http://localhost:3001

# Exact browser origin(s), comma separated; no trailing slashes or wildcards.
CORS_ORIGIN=http://localhost:8080

# Shared upstream cache and request timeout; values remain bounded by the API.
CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=8000

# No API key, database or account is needed for the integrated public sources.
